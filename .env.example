# LLM provider (external APIs allowed per organizers, #challenge Slack 2026-09-25). See agent/README.md.
# anthropic | openai | groq | gemini | ollama | openai_compatible | fake
LLM_PROVIDER=fake
LLM_MODEL=
# Required for openai_compatible; optional override otherwise (Ollama default: http://localhost:11434/v1)
LLM_BASE_URL=
# Name of the variable that holds the key, when it is not the provider default
LLM_API_KEY_ENV=
LLM_TIMEOUT_S=30
# Optional, OpenAI-compatible reasoning models only (gpt-6-luna accepts none, low, medium, high, xhigh)
LLM_REASONING_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# LATAM Bank dataset on Amazon S3 (read-only participant credentials).
# Copy this file to .env and fill the values there only; .env is git-ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Defaults to us-east-2 when empty
AWS_REGION=
# The prefix that holds the table folders, s3://<bucket>/data (the bucket root has only one table). Read by `make mirror`,
# which copies it into data/raw, and by the pipeline when --source is omitted.
LATAM_BANK_S3_URI=

# Session signing secret for the test identity service (generate a long random value)
SESSION_SECRET=
