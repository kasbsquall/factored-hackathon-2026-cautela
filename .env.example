# LLM provider (external APIs allowed per organizers, #challenge Slack 2026-09-25)
ANTHROPIC_API_KEY=

# Path to the organizer-supplied LATAM Bank dataset (never committed)
LATAM_BANK_DATA_DIR=./data/raw

# LATAM Bank dataset on Amazon S3 (read-only participant credentials).
# Copy this file to .env and fill the values there only; .env is git-ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Defaults to us-east-2 when empty
AWS_REGION=
# Default pipeline source when --source is omitted, e.g. s3://<bucket>/<prefix>
LATAM_BANK_S3_URI=

# Session signing secret for the test identity service (generate a long random value)
SESSION_SECRET=
