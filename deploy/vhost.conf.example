# OpenLiteSpeed virtual host for the Cautela API (CyberPanel layout). Example, not a drop-in: see deploy/README.md.
#
# Create the site in CyberPanel first (Websites > Create Website, name cautela.107-172-6-206.sslip.io, no PHP
# needed) and issue its certificate there. CyberPanel writes
#   /usr/local/lsws/conf/vhosts/cautela.107-172-6-206.sslip.io/vhost.conf
# Keep what it generated (docRoot, logs, its ACME context and vhssl paths) and add the three marked blocks below:
# the extprocessor, the /.well-known/ context (if CyberPanel did not write one) and the proxy context for /.
# Then: /usr/local/lsws/bin/lswsctrl restart   (a graceful restart; other sites keep serving)
#
# Placeholders: <SITE> = cautela.107-172-6-206.sslip.io, <USER> = the Linux user CyberPanel created for the site.

docRoot                   /home/<SITE>/public_html
vhDomain                  <SITE>
adminEmails               <admin email>
enableGzip                1
enableIpGeo               1

errorlog $VH_ROOT/logs/<SITE>.error_log {
  useServer               0
  logLevel                WARN
  rollingSize             10M
}

accesslog $VH_ROOT/logs/<SITE>.access_log {
  useServer               0
  logFormat               "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\""
  logHeaders              5
  rollingSize             10M
  keepDays                10
  compressArchive         1
}

# ---- ADD: the backend. Loopback only; the container publishes 127.0.0.1:8330 and nothing else. -------------
extprocessor cautela_api {
  type                    proxy
  address                 127.0.0.1:8330
  maxConns                20
  initTimeout             20
  retryTimeout            0
  respBuffer              0
}

# ---- ACME: served from disk, never proxied. -----------------------------------------------------------------
# OpenLiteSpeed picks the longest matching context, so this one wins over "/" below and a certificate renewal is
# answered by files on disk even when the API is down. If CyberPanel already wrote an acme-challenge context,
# keep its location and skip this block.
context /.well-known/ {
  location                /home/<SITE>/public_html/.well-known/
  allowBrowse             1
  addDefaultCharset       off

  rewrite  {
    enable                0
  }
}

# ---- ADD: everything else goes to the API. ------------------------------------------------------------------
# The API already sends X-Content-Type-Options, X-Frame-Options, Referrer-Policy and Cache-Control: no-store;
# `set` replaces rather than duplicates them. CSP stays at frame-ancestors so /docs (Swagger UI from a CDN) works.
context / {
  type                    proxy
  handler                 cautela_api
  addDefaultCharset       off
  extraHeaders            <<<END_extraHeaders
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Content-Security-Policy "frame-ancestors 'none'"
Header always unset X-Powered-By
  END_extraHeaders
}

# HTTP to HTTPS, except the ACME path.
rewrite  {
  enable                  1
  autoLoadHtaccess        0
  rules                   <<<END_rules
RewriteCond %{SERVER_PORT} 80
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  END_rules
}

# TLS. Copy the paths CyberPanel wrote after issuing the certificate; these are its usual locations.
vhssl  {
  keyFile                 /etc/letsencrypt/live/<SITE>/privkey.pem
  certFile                /etc/letsencrypt/live/<SITE>/fullchain.pem
  certChain               1
  sslProtocol             24
  enableECDHE             1
  renegProtection         1
  sslSessionCache         1
  enableSpdy              15
  enableStapling          1
  ocspRespMaxAge          86400
}
