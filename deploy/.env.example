# Copy to deploy/.env on the server, fill it there, chmod 600. deploy/.env is git-ignored and never copied into
# the image or the release tarball. Names only; the comment says what goes in each.

# Model. Intended values: openai, gpt-6-luna, none (reasoning tokens bill as output). Empty LLM_PROVIDER means
# no model: the deterministic parser and reply templates answer every turn.
LLM_PROVIDER=
LLM_MODEL=
LLM_REASONING_EFFORT=
# Provider key. Use a project key with a hard spend limit set in the provider console as well.
OPENAI_API_KEY=

# Daily caps (agent/llm/budget.py). Empty means the compose defaults: 2000 calls and USD 1.00 per UTC day.
LLM_DAILY_MAX_CALLS=
LLM_DAILY_MAX_USD=

# At least 32 bytes: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Key for /console/* (X-Console-Key). Generate it the same way; share it only with the people running the demo.
CAUTELA_CONSOLE_KEY=
# Comma-separated origins allowed by CORS, e.g. the frontend's https origin. No wildcard.
CAUTELA_CORS_ORIGINS=
# 1 exposes the seeded demo identities and their one-time codes (needed for the public demo); 0 hides both.
# Empty means 1 in docker-compose.behind-proxy.yml. Outside that file the service defaults to off.
CAUTELA_DEMO_MODE=
# Shared with the frontend proxy (Vercel env CAUTELA_PROXY_KEY), at least 32 characters, generated like
# SESSION_SECRET. With it the API keys rate limits on the visitor address the proxy sends; without it every visitor
# who comes through the frontend shares one bucket.
CAUTELA_PROXY_KEY=
# Seconds between demo resets. Empty means 1800.
CAUTELA_DEMO_RESET_S=

# Docker network for this project. Empty means 10.83.30.0/24 with gateway 10.83.30.1; change both together only
# if that range overlaps a route on the host (ip route).
CAUTELA_SUBNET=
CAUTELA_PROXY_GATEWAY=

# Public demo throttles. The test identities are shared by every visitor and their codes are shown on screen,
# so the demo raises the per-document login cap (default 3 per 15 min) and the per-address limits (auth 10/60,
# turns 30/60), keeping them bounded. A group of reviewers behind one office address shares the per-address limit.
CAUTELA_LOGIN_CHALLENGES=
CAUTELA_RATE_AUTH=
CAUTELA_RATE_TURN=
# Console and audit reads per address (default 60/60). Translation model calls: across all visitors (default
# 30/3600) and per login session (default 10); cached translations do not count.
CAUTELA_RATE_CONSOLE=
CAUTELA_RATE_TRANSLATE=
CAUTELA_TRANSLATE_PER_SESSION=
