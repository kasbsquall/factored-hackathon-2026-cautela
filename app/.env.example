# mock: synthetic fixtures in src/lib/api/mock, no backend needed (default)
# live: the FastAPI service in api/ (uv run python -m api)
NEXT_PUBLIC_API_MODE=mock

# Live only. Leave empty to use the same-origin proxy at /api/cautela (recommended: no CORS, no key in the browser).
NEXT_PUBLIC_API_BASE_URL=

# Live only, server side (never prefix these with NEXT_PUBLIC_).
CAUTELA_API_URL=http://127.0.0.1:8000
# The console proxy stays off unless this is "enabled". Enabling it exposes the console to anyone who can open
# the app, so only do it locally or behind the console's own access control.
CAUTELA_CONSOLE_PROXY=
CAUTELA_CONSOLE_KEY=
